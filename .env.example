ANTHROPIC_API_KEY=
RAZORPAY_TEST_KEY_ID=
RAZORPAY_TEST_KEY_SECRET=
SEED=42

# Real voice-note generation (packet P14). gTTS is free and needs no credential,
# so this is opt-OUT rather than opt-in: leave it unset and reminders get real,
# playable MP3 audio. Set PK_REAL_TTS=0 on an air-gapped machine or in CI — the
# reminder is still created with its transcript, marked audio_generation:
# "disabled" (which is deliberately NOT the same as "failed").
# Note what is and is not real either way: the AUDIO is genuinely generated; the
# DIAL is not. No phone is called and no SMS reaches a handset — there is no
# telephony/SMS-gateway credential in this project, and every record says so.
PK_REAL_TTS=

# Real phone call + real WhatsApp message (packet P16). OPT-IN, unlike
# PK_REAL_TTS above: ringing a real phone or messaging a real WhatsApp
# account is a real-world effect on a real person, so it needs an explicit
# "yes" even when the Twilio credentials below are filled in. It also only
# ever fires for a MANUAL click (never the autonomous escalation ladder) on
# an entity with a real operator-submitted contact (never the synthetic demo
# number) — see engine/action/telephony.py and
# WorldRunner._should_go_real_telephony for the full gate.
PK_REAL_TELEPHONY=
# Two credential shapes are accepted (Twilio's console offers both):
#   1. TWILIO_ACCOUNT_SID + TWILIO_AUTH_TOKEN (Console dashboard home), or
#   2. TWILIO_ACCOUNT_SID + TWILIO_API_KEY_SID + TWILIO_API_KEY_SECRET
#      (Console -> API keys & tokens) - the API key alone is not enough, it
#      needs the Account SID alongside it to say which account it belongs to.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_PHONE_NUMBER=
# Twilio's shared WhatsApp Sandbox number - leave as-is unless you've moved to
# a production WhatsApp Business sender.
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Required for real calls specifically: Twilio TRIAL accounts reject inline
# TwiML on Calls.create() ("Invalid or disallowed parameters... trial accounts
# have limited parameter access" - confirmed live, tracking/BUILD_LOG.md
# 2026-08-27). place_call() instead points Twilio at this app's own
# GET /telephony/twiml route, which means Twilio's servers must be able to
# reach THIS app - deployed, or tunnelled (Tailscale Funnel/Cloudflare
# Tunnel). No trailing slash, e.g. https://your-app.onrender.com
PUBLIC_BASE_URL=

# Real Telegram messages: text and real generated audio (packet P17,
# replacing the Twilio-WhatsApp attempt as this project's actual real-message
# channel - see tracking/DECISIONS.md 2026-08-27 for why WhatsApp hit real
# walls at every turn while Telegram's Bot API is free forever, no card, no
# template approval, no business verification). OPT-IN like PK_REAL_TELEPHONY,
# same reasoning: a real Telegram send reaches a real person.
PK_REAL_TELEGRAM=
# From @BotFather (send /newbot in Telegram) - free, instant, no approval.
TELEGRAM_BOT_TOKEN=
